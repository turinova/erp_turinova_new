{
  "name": "vezetoi-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.0",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.0",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.75.0",
    "panelui-native": "^1.5.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.14.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.26",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "clean-appledouble": "find . \\( -name '._*' -o -name '.DS_Store' \\) -delete 2>/dev/null; true",
    "start": "npm run clean-appledouble && expo start",
    "start:dev": "npm run clean-appledouble && expo start --dev-client",
    "android": "npm run clean-appledouble && expo start --android",
    "ios": "npm run clean-appledouble && expo start --ios",
    "ios:device": "npm run clean-appledouble && expo run:ios --device",
    "eas:build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "eas:build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "web": "expo start --web",
    "tunnel": "npm run clean-appledouble && expo start --tunnel"
  },
  "private": true
}
