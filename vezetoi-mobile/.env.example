# Ugyanaz a Supabase project, mint a modul-app (publishable / anon key — NEM service role)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Staff webes host — a Kezdőlap számai innen jönnek (/api/m/v1/*), és ide nyit a „Megnyitás a weben”.
# Fejlesztés: a Mac LAN IP-je + modul-app port (a telefon ugyanazon a Wi-Fin), pl. http://192.168.1.23:3010
# Éles: https://app.optinova.hu (ez az alapértelmezés, ha üres)
EXPO_PUBLIC_API_URL=
