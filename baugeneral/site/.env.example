# Copy to .env.local — same keys in Vercel → Environment Variables.

MAIL_TO=mezo.david@baugeneral.hu

# --- Gmail SMTP (recommended for BauGenerál while Resend domain is busy) ---
# 1) Google Account → 2FA on
# 2) https://myaccount.google.com/apppasswords → create "Mail" password
# 3) Paste below (16 chars, spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.name@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=your.name@gmail.com

# --- Optional: Resend (only if SMTP_* not set) ---
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=BauGenerál weboldal <onboarding@resend.dev>

# --- Google Search Console (optional override; default token is in layout.tsx) ---
# GOOGLE_SITE_VERIFICATION=uE5yQWs0cZTUxSF0yxxT_A3VrjJh1GsCwkeL-T3lWuo
