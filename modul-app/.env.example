# Supabase (kötelező SaaS authhoz)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Szerver only — felhasználó létrehozás / platform admin / email lista
SUPABASE_SERVICE_ROLE_KEY=

# P2: aláírt session snapshot (HMAC). Prod-ban kötelező, külön secret.
SESSION_SNAPSHOT_SECRET=

# Platform admin: a user emailjét add a platform_admins táblába
# (lásd supabase/migrations/20260326_platform_admin.sql)

# Csak akkor használd, ha NINCS Supabase URL/key (shell demo)
# Ha a SUPABASE_* ki van töltve, az app Supabase Authot használ.
AUTH_DEV_BYPASS=true

# Csak dev bypass topbar névhez (Supabase-nél a tenant.name jön)
NEXT_PUBLIC_DEMO_COMPANY_NAME=Demo Asztalos Kft.

# Partner jogi dokumentumok (optinova.hu) — az app csak linkel
# NEXT_PUBLIC_LEGAL_ASZF_URL=https://optinova.hu/aszf
# NEXT_PUBLIC_LEGAL_PRIVACY_URL=https://optinova.hu/adatkezelesi-tajekoztato
# NEXT_PUBLIC_LEGAL_IMPRESSUM_URL=https://optinova.hu/impresszum

# Quote ready SMS (platform Twilio — quote_ready_sms add-on)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
