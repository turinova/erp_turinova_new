# Copy to .env.local for local development.
# Set the same values in Vercel → Project Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional analytics (loaded according to cookie consent)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id
# Meta Pixel (Facebook/Instagram ads) — marketing consent után aktív
NEXT_PUBLIC_META_PIXEL_ID=

# Rackhost SMTP (SSL, port 465)
SMTP_HOST=mail.hirosablak.hu
SMTP_PORT=465
SMTP_USER=teszt@hirosablak.hu
SMTP_PASS=your_mailbox_password

# Outgoing From must be an authenticated mailbox on mail.hirosablak.hu
MAIL_FROM=teszt@hirosablak.hu
MAIL_TO=hirosablak@hirosablak.hu
# A felmérés űrlap (felmeres) a MAIL_TO mellett mindig megy: mezo.david@baugeneral.hu

# Konyhatervező (béta) — Black Forest Labs Flux
# https://docs.bfl.ai — EU: https://api.eu.bfl.ai
BFL_API_KEY=
# Optional override (default api.eu.bfl.ai)
# BFL_API_BASE=https://api.eu.bfl.ai
# Motor: flux2max (default, drótváz + FLUX.2 max — ez a mérethű), flux2 (FLUX.2
# pro), kontext vagy pro (csak prompt). A max drágább, de mérve ez tartja az
# élek helyét ±0,5 cm-en; a pro 7–13 cm-t csúsztat.
# KONYHATERVEZO_ENGINE=flux2max
# A seed a beállításokból számolódik (ugyanaz a fal → ugyanaz a kép), nincs env.
# Optional shared secret: require ?key= or x-konyhatervezo-key header
# KONYHATERVEZO_BETA_KEY=
