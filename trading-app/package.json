{
  "name": "trading-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-local-cache.sh",
    "dev:plain": "next dev -p 3010",
    "dev:clean": "find . -name '._*' -not -path './node_modules/*' -delete 2>/dev/null; rm -rf .next \"$HOME/.cache/trading-app-next\"; bash scripts/dev-local-cache.sh",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "fetch-data": "node scripts/fetch-bars.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.105.3",
    "lightweight-charts": "^5.2.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
