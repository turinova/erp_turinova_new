# Supabase (külön projekt, nem a main-app-é!)
# Supabase dashboard → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel deployhoz (a Vercel dashboardon állítsd be, lokálisan nem kell):
# SUPABASE_SECRET_KEY: Supabase → Project Settings → API keys → service_role
# CRON_SECRET: tetszőleges hosszú random string — a Vercel Cron ezzel hitelesít
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Tradovate real-time feed (opcionális — ha üres, Yahoo a forrás)
# Tradovate Trader → Application Settings → API Access (add-on szükséges)
# TRADOVATE_ENV: demo vagy live
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_ENV=demo
