{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/group-rules",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/signup-cleanup",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/order-facts",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/customer-mirror",
      "schedule": "25 */2 * * *"
    },
    {
      "path": "/api/cron/customer-groups",
      "schedule": "40 */6 * * *"
    }
  ]
}
