# App — local
NEXT_PUBLIC_APP_URL=http://localhost:3030
# Live shop test (HTTPS): run `npm run tunnel` in another terminal, then set:
# NEXT_PUBLIC_APP_URL=https://xxxx.trycloudflare.com
# and paste that same URL into the shop script (apiBase + widget.js src).
# Vercel Production: https://app.progate.hu
# Marketing site: https://progate.hu (same Next app, host split in middleware)
# Keep this env on the APP origin — widget/API must not use progate.hu
# SYNC_WORKER_DISABLED=1 is implied on Vercel (no background catalog loop)

# Postgres — AFTER you manually run b2b-portal/sql/001 → 007
# Local: Direct or pooler URI is fine.
# Vercel: Supabase Transaction pooler (port 6543), not db.xxx.supabase.co
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Shop API secrets at rest (AES-256-GCM) — 32 bytes hex
#   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Session signing / cookie
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: local single-tenant fallback if API called without shopId
# (prefer merchant DB credentials + shopId in widget config)
# SHOPRENTER_SHOP_NAME=
# SHOPRENTER_USERNAME=
# SHOPRENTER_PASSWORD=
# SHOPRENTER_STORE_URL=

# Shoprenter App Store (Embedded) — partnersupport registration
# EntryPoint:  https://app.progate.hu/sr-embed
# RedirectUri: https://app.progate.hu/api/shoprenter/install
# UninstallUri: https://app.progate.hu/api/shoprenter/uninstall
# SR_APP_CLIENT_ID=
# SR_APP_CLIENT_SECRET=
# Local iframe preview without HMAC: SR_EMBED_DEV=1 and /sr-embed?dev=1&shopname=yourshop
# SR_EMBED_DEV=1
# Force SameSite=None cookie locally (tunnel): SR_EMBED_SECURE_COOKIE=1
# Widget storefront install: manual | script_tag | stub_success | stub_fail
# Requires App scope store.scriptTag:write for script_tag. Run sql/040_shop_widget_script.sql
# SR_INSTALL_MODE=manual

# App Store Payment API (recurringCharges) — run sql/041_embed_ops_billing.sql
# Create plans on https://billing.shoprenter.hu/plans then set IDs:
# SR_BILLING_ENABLED=1
# SR_BILLING_TEST=1
# SR_PLAN_ID_MONTHLY=
# SR_PLAN_ID_ANNUAL=

# Optional: image order parse (Claude vision)
# ANTHROPIC_API_KEY=

# Riport: 1 = shop_order_facts DB path (futtasd sql/029 + sync), 0 = élő Shoprenter
# REPORT_USE_ORDER_FACTS=0

# Self-serve signup: localban a verify URL a JSON válaszban is jön.
# Prod: állítsd 0-ra / hagyd üresen, és köss email küldőt (logban mindig ott a link).
# SIGNUP_RETURN_VERIFY_URL=1

# Vercel Cron (/api/cron/group-rules, /api/cron/order-facts, /api/cron/customer-groups, /api/cron/signup-cleanup)
# CRON_SECRET=

# Marketing landing: live | coming_soon (portal/login/widget unchanged)
# PROGATE_LANDING_MODE=coming_soon
