# EAS: replaces .gitignore for the upload archive (git root = monorepo).
# Goal: only vezetoi-mobile source goes up (not the whole ERP tree).
# Docs: https://docs.expo.dev/build-reference/easignore/

# --- from root .gitignore ---
node_modules/
.pnp
.pnp.js
coverage/
.next/
out/
build/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.vercel
.DS_Store
._*
**/._*
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-*
.turbo
__pycache__/
*.py[cod]
nav-exports/
hiros-ablak/_notes/
baugeneral/_squarespace-download/
trading-app/

